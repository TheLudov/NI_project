# e3_web.scn (E3, Atieh): web alone, as in scenarios/web.scn but with no replica churn (no upgrade, no failures,
# no scale-out) and no LB churn, so that the set of replicas is fixed and the balance can be read. 4 minutes.
duration 4min
warmup 66

service web
  vip 198.51.100.30 port 443 proto tcp
  replicas 48 10.3.0.1
  model web flows=5000 lifetime_median=300ms h1_share=0.3
